# Set this only in the deployment secret manager or local shell; never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PORT=8787
# Set only for the local Experience Builder origin; required for browser testing.
MAP_NARRATOR_ALLOWED_ORIGIN=https://127.0.0.1:3001
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional per-language voices (fall back to ELEVENLABS_VOICE_ID). Use a native English voice for EN.
ELEVENLABS_VOICE_ID_EN=
ELEVENLABS_VOICE_ID_ES=
ELEVENLABS_MODEL=eleven_multilingual_v2
